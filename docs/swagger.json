{
    "swagger": "2.0",
    "info": {
        "description": "Swagger doc for Bookmark Management API.",
        "title": "Bookmark Management API",
        "contact": {},
        "version": "1.0.0"
    },
    "basePath": "/",
    "paths": {
        "/genpass": {
            "get": {
                "description": "Generates a random 10-character password made of letters (A-Z, a-z) and digits (0-9), using a cryptographically secure random source.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "password"
                ],
                "summary": "Generate a random password",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/handler.GenPassResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/handler.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/health-check": {
            "get": {
                "description": "Reports that the service is up, along with its service name and instance ID.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "health"
                ],
                "summary": "Health check",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/service.HealthCheckResult"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "handler.ErrorResponse": {
            "type": "object",
            "properties": {
                "error": {
                    "type": "string",
                    "example": "Failed to generate password"
                }
            }
        },
        "handler.GenPassResponse": {
            "type": "object",
            "properties": {
                "password": {
                    "type": "string",
                    "example": "aB3dE9xYz1"
                }
            }
        },
        "service.HealthCheckResult": {
            "type": "object",
            "properties": {
                "instance_id": {
                    "type": "string",
                    "example": "3f2b8c1e-7a54-4d0e-9b6a-1c2d3e4f5a6b"
                },
                "message": {
                    "type": "string",
                    "example": "OK"
                },
                "service_name": {
                    "type": "string",
                    "example": "bookmark_service"
                }
            }
        }
    }
}